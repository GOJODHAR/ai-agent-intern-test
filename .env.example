# Aster & Row Support Agent Configurations

# The Gemini API Key required for model inference. Get one from Google AI Studio.
# This variable can also be named GOOGLE_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here

# Log level for internal observability (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Model selection (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
